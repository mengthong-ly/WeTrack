DATABASE_URL=postgres://localhost:5432/wetrack
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100
# Local mail goes to Mailpit (http://localhost:8025). Production uses Resend SMTP:
# SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=re_… (API key)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="WeTrack <no-reply@wetrack.local>"
# Optional: "Continue with Google" and Google Calendar + Meet for meetings. Leave empty to turn both off.
# Redirect URI in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared by the weekly digest and meeting reminder crons (sent as a Bearer header). Generate: openssl rand -hex 24
CRON_SECRET=generate-with-openssl-rand-hex-24
# Time zone meeting times are entered and shown in, in the app and in Slack posts.
APP_TIMEZONE=Asia/Phnom_Penh
# Optional: Cloudflare R2 for uploaded images (a private bucket; the app serves them to the workspace).
# Leave R2_BUCKET empty to keep images in Postgres. Token needs Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
